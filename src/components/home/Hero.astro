---
import { Image } from "astro:assets"
import purpleCactus from "../../images/purple-flower-cactus.png"
---

<section>
  <h1>Nurturing the Unloved, Protecting the Undervalued.</h1>
  <Image
    class="hero__image"
    src={purpleCactus}
    alt="A cactus with purple flowers"
  />
  <h2 class="alegreya-sc--400">
    A grassroots effort to protect and restore native South Texas thornscrub —
    one of the most overlooked and threatened habitats in North America.
  </h2>
</section>

<style>
  section {
    margin-right: auto;
    margin-left: auto;
    max-width: 1200px;
    padding-top: 3.125em;
    padding-bottom: 3.125em;
    padding-left: 1.25em;
    padding-right: 1.25em;
    color: var(--charcoal-shade);
  }
  h1 {
    font-size: 2.5em;
    text-align: center;
  }
  h2 {
    margin-top: 1.5em;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
    max-width: 892px;
    font-size: 24px;
  }
  .hero__image {
    display: block;
    margin-top: 1.5em;
    margin-left: auto;
    margin-right: auto;
    border-radius: 4px;
    max-width: 100%;
    height: auto;
  }
</style>
